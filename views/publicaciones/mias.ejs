<%- include('../partials/head') %>
<%
  const cuenta = (e) => publicaciones.filter(p => p.estado === e).length;
  const consultas = publicaciones.reduce((s, p) => s + p.consultas, 0);
%>

<h1>Mis publicaciones</h1>
<p class="gris">
  <%= cuenta('publicada') %> publicadas &middot; <%= cuenta('vendida') %> vendidas/entregadas &middot;
  <%= cuenta('en_revision') %> en revisión &middot; <%= cuenta('rechazada') %> rechazadas &middot; <%= consultas %> consultas de contacto
  <% if (usuario.puede_publicar) { %> &middot; <a href="/publicaciones/nueva">nueva publicación</a><% } %>
</p>

<% if (usuario.strikes > 0) { %>
  <div class="msg msg-error">Tienes <%= usuario.strikes %> de 3 strikes. Al llegar a 3 tu cuenta se bloquea.</div>
<% } %>

<% if (!publicaciones.length) { %>
  <p class="centro gris">Todavía no publicas nada. <a href="/publicaciones/nueva">publica tu primer artículo</a>.</p>
<% } else { %>
  <table class="tabla">
    <tr><th></th><th>artículo</th><th>precio</th><th>estado</th><th class="num">consultas</th><th>acciones</th></tr>
    <% publicaciones.forEach(p => { %>
      <tr>
        <td class="mini"><img src="<%= p.portada ? '/uploads/' + p.portada : '/img/sin-foto.svg' %>" alt=""></td>
        <td><a href="/publicaciones/<%= p.id %>"><%= p.titulo %></a><br><small class="gris"><%= f.hace(p.creado_en) %></small></td>
        <td class="<%= p.es_donacion ? 'dona' : 'precio' %>"><%= f.precio(p.precio) %></td>
        <td>
          <% const colores = { publicada: '#000', en_revision: '#e00000', rechazada: '#e00000', vendida: '#666' }; %>
          <span style="color:<%= colores[p.estado] %>"><%= f.ESTADOS[p.estado].toLowerCase() %></span>
        </td>
        <td class="num"><% if (p.consultas) { %><a href="/publicaciones/<%= p.id %>/consultas"><%= p.consultas %></a><% } else { %>0<% } %></td>
        <td class="chico">
          <% if (p.estado === 'publicada' || p.estado === 'vendida') { %>
            <a href="/publicaciones/<%= p.id %>/editar">editar</a> &middot;
            <form class="enlinea" action="/publicaciones/<%= p.id %>/vendida" method="post"><button class="enlace" type="submit"><%= p.estado === 'vendida' ? 'reactivar' : (p.es_donacion ? 'entregada' : 'vendida') %></button></form> &middot;
          <% } %>
          <% if (p.estado !== 'en_revision') { %>
            <form class="enlinea" action="/publicaciones/<%= p.id %>/eliminar" method="post" data-confirmar="¿Eliminar «<%= p.titulo %>»?"><button class="enlace" type="submit">eliminar</button></form>
          <% } else { %>
            <span class="gris">esperando revisión</span>
          <% } %>
        </td>
      </tr>
    <% }) %>
  </table>
<% } %>

<%- include('../partials/foot') %>
