<%- include('../partials/head') %>
<%
  const v = valores || {};
  const accion = pub ? `/publicaciones/${pub.id}/editar` : '/publicaciones';
  const marcadas = [].concat(v.quitar_imagen || []).map(String);
%>

<h1 class="centro"><%= pub ? 'Editar publicación' : 'Publicar artículo' %></h1>
<p class="centro gris">Una foto clara y una descripción honesta hacen que te contacten más rápido.</p>

<% if (Object.keys(errores).length) { %><div class="msg msg-error">Revisa los campos marcados.</div><% } %>

<form action="<%= accion %>" method="post" enctype="multipart/form-data" novalidate data-form-publicacion>
  <table class="forma">
    <tr>
      <td><label for="titulo">título</label></td>
      <td>
        <input class="ancho" id="titulo" name="titulo" maxlength="120" value="<%= v.titulo || '' %>" placeholder="ej. bicicleta rodada 26" aria-invalid="<%= !!errores.titulo %>" data-contar="120">
        <% if (errores.titulo) { %><span class="error"><%= errores.titulo %></span><% } %>
      </td>
    </tr>
    <tr>
      <td><label for="categoria_id">categoría</label></td>
      <td>
        <select id="categoria_id" name="categoria_id" aria-invalid="<%= !!errores.categoria_id %>">
          <option value="">-- elige --</option>
          <% categorias.forEach(c => { %><option value="<%= c.id %>" <%= String(v.categoria_id) === String(c.id) ? 'selected' : '' %>><%= c.nombre %></option><% }) %>
        </select>
        <% if (errores.categoria_id) { %><span class="error"><%= errores.categoria_id %></span><% } %>
      </td>
    </tr>
    <tr>
      <td><label for="precio">precio $</label></td>
      <td>
        <input id="precio" name="precio" inputmode="decimal" size="12" value="<%= v.precio ?? '' %>" placeholder="0.00" aria-invalid="<%= !!errores.precio %>" data-precio>
        <span class="ayuda" data-precio-vista>Obligatorio. Escribe 0 si lo quieres regalar.</span>
        <% if (errores.precio) { %><span class="error"><%= errores.precio %></span><% } %>
      </td>
    </tr>
    <tr>
      <td><label for="descripcion">descripción</label></td>
      <td>
        <textarea id="descripcion" name="descripcion" maxlength="3000" placeholder="estado, medidas, tiempo de uso, detalles, zona de entrega..." aria-invalid="<%= !!errores.descripcion %>" data-contar="3000"><%= v.descripcion || '' %></textarea>
        <% if (errores.descripcion) { %><span class="error"><%= errores.descripcion %></span><% } %>
      </td>
    </tr>
    <tr>
      <td>fotos</td>
      <td>
        <% if (imagenes.length) { %>
          <span class="ayuda">Marca las fotos que quieras quitar.</span>
          <div class="fotos">
            <% imagenes.forEach((img, i) => { %>
              <label class="foto">
                <input type="checkbox" name="quitar_imagen" value="<%= img.id %>" <%= marcadas.includes(String(img.id)) ? 'checked' : '' %> style="display:none">
                <img src="/uploads/<%= img.ruta %>" alt="foto <%= i + 1 %>">
                <%= i === 0 ? 'portada · ' : '' %><span style="text-decoration:underline;cursor:pointer;color:#e00000">quitar</span>
              </label>
            <% }) %>
          </div>
          <br>
        <% } %>
        <label class="zona-fotos" data-zona-fotos>
          <input type="file" name="imagenes" accept="image/jpeg,image/png,image/webp" multiple data-fotos data-max="<%= maxImagenes - imagenes.length %>">
          <%= imagenes.length ? 'agregar más fotos' : 'elige o arrastra tus fotos aquí' %><br>
          <small class="gris">máximo <%= maxImagenes %> en total &middot; jpg, png o webp de hasta 5 MB &middot; la primera es la portada</small>
        </label>
        <div class="fotos" data-vista-fotos></div>
        <% if (errores.imagenes) { %><span class="error"><%= errores.imagenes %></span><% } %>
      </td>
    </tr>
    <tr>
      <td></td>
      <td>
        <p class="chico gris">Al publicar, el texto y las fotos pasan por una revisión automática. Si algo parece prohibido, la publicación se oculta hasta que un administrador la revise y no podrás publicar mientras tanto.</p>
        <button type="submit" class="rojo" data-enviar><%= pub ? 'guardar cambios' : 'publicar' %></button>
        &nbsp; <a href="<%= pub ? '/publicaciones/' + pub.id : '/mis-publicaciones' %>">cancelar</a>
      </td>
    </tr>
  </table>
</form>

<%- include('../partials/foot') %>
