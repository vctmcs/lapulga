<%- include('../partials/head') %>
<% const esAdmin = usuario && usuario.rol === 'admin'; %>

<p class="chico gris">
  <a href="/">inicio</a> &raquo;
  <% if (pub.categoria) { %><a href="/?cat=<%= pub.categoria_slug %>"><%= pub.categoria.toLowerCase() %></a> &raquo;<% } %>
  <%= pub.titulo %>
</p>

<% if (pub.estado === 'en_revision') { %><div class="msg msg-alerta">Esta publicación está oculta mientras el administrador la revisa.</div><% } %>
<% if (pub.estado === 'rechazada') { %><div class="msg msg-error">Esta publicación fue rechazada por moderación y nadie más la puede ver.</div><% } %>
<% if (pub.estado === 'vendida') { %><div class="msg msg-info"><%= pub.es_donacion ? 'Este artículo ya fue entregado.' : 'Este artículo ya se vendió.' %></div><% } %>

<div class="detalle">
  <div data-galeria>
    <div class="principal">
      <img src="<%= imagenes.length ? '/uploads/' + imagenes[0].ruta : '/img/sin-foto.svg' %>" alt="<%= pub.titulo %>" data-galeria-principal>
    </div>
    <% if (imagenes.length > 1) { %>
      <div class="miniaturas">
        <% imagenes.forEach((img, i) => { %>
          <button type="button" data-src="/uploads/<%= img.ruta %>" aria-current="<%= i === 0 %>" aria-label="foto <%= i + 1 %>"><img src="/uploads/<%= img.ruta %>" alt="" loading="lazy"></button>
        <% }) %>
      </div>
    <% } %>
  </div>

  <div>
    <h1><%= pub.titulo %></h1>
    <p>
      <span class="<%= pub.es_donacion ? 'dona' : 'precio' %>" style="font-size:20px"><%= f.precio(pub.precio) %></span><br>
      <small class="gris"><%= pub.categoria || 'sin categoría' %> &middot; publicado <%= f.hace(pub.creado_en) %></small>
    </p>

    <p>
      <%= pub.es_donacion ? 'Dona' : 'Vende' %>: <a href="/usuarios/<%= pub.usuario_id %>"><%= pub.vendedor %></a><br>
      <small class="gris">en la pulga desde <%= f.fecha(pub.vendedor_desde) %></small>
    </p>

    <% if (esDueno) { %>
      <div class="caja punteada">
        Es tu publicación.
        <% if (pub.estado === 'publicada' || pub.estado === 'vendida') { %><a href="/publicaciones/<%= pub.id %>/editar">editar</a> &middot;<% } %>
        <a href="/mis-publicaciones">mis publicaciones</a>
      </div>
    <% } else if (pub.estado === 'publicada') { %>
      <div class="caja" data-contacto data-id="<%= pub.id %>">
        <h3>Contacto</h3>
        <% if (!usuario) { %>
          <p>El teléfono y el WhatsApp solo se muestran a usuarios registrados.</p>
          <a href="/registro">crear cuenta gratis</a> &middot; <a href="/login">entrar</a>
        <% } else { %>
          <div data-contacto-datos hidden></div>
          <button type="button" class="amarillo" data-contacto-ver><%= yaConsulto ? 'ver el contacto otra vez' : 'ver teléfono y WhatsApp' %></button>
          <p class="chico gris" style="margin:6px 0 0">Cada consulta del contacto queda registrada.</p>
        <% } %>
      </div>
    <% } %>

    <h3>Descripción</h3>
    <p class="descripcion"><%= pub.descripcion %></p>

    <% if (usuario && !esDueno && pub.estado === 'publicada') { %>
      <hr>
      <% if (esAdmin) { %>
        <form action="/publicaciones/<%= pub.id %>/ocultar" method="post">
          <small class="gris">admin: si la IA dejó pasar algo prohibido, ocúltala y mándala a revisión.</small><br>
          <input name="detalle" maxlength="300" placeholder="nota (opcional)" style="width:60%">
          <button type="submit" class="rojo">ocultar y revisar</button>
        </form>
      <% } else { %>
        <details>
          <summary class="chico" style="cursor:pointer;color:#8a8a8a">reportar esta publicación</summary>
          <form action="/publicaciones/<%= pub.id %>/reportar" method="post" style="margin-top:6px">
            <select name="motivo" required>
              <% Object.entries(motivos).forEach(([k, v]) => { %><option value="<%= k %>"><%= v %></option><% }) %>
            </select><br>
            <input name="detalle" maxlength="300" placeholder="detalle (opcional)" style="width:100%;margin:6px 0">
            <button type="submit">enviar reporte</button>
          </form>
        </details>
      <% } %>
    <% } %>
  </div>
</div>

<% if (otras.length) { %>
  <hr>
  <h2>Más de <%= pub.vendedor.split(' ')[0] %></h2>
  <div class="lista">
    <% otras.forEach(p => { %><%- include('../partials/tarjeta', { p }) %><% }) %>
  </div>
<% } %>

<%- include('../partials/foot') %>
