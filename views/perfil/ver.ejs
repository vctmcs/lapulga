<%- include('../partials/head') %>

<h1><%= perfil.nombre %></h1>
<p class="gris">
  <%= perfil.rol %> &middot; en la pulga desde <%= f.fecha(perfil.creado_en) %>
  <% if (perfil.rol === 'vendedor') { %>
    &middot; <%= perfil.activas %> <%= perfil.activas === 1 ? 'publicación activa' : 'publicaciones activas' %>
    <% if (perfil.donaciones) { %>&middot; <span class="dona"><%= perfil.donaciones %> en donación</span><% } %>
  <% } %>
  <% if (esPropio) { %>&middot; <a href="/cuenta">editar mi cuenta</a><% } %>
</p>
<p class="chico gris">Las reseñas de este usuario estarán disponibles pronto.</p>
<hr>

<% if (perfil.rol === 'vendedor') { %>
  <% if (publicaciones.length) { %>
    <div class="lista">
      <% publicaciones.forEach(p => { %><%- include('../partials/tarjeta', { p }) %><% }) %>
    </div>
  <% } else { %>
    <p class="centro gris">No tiene publicaciones activas por ahora.</p>
  <% } %>
<% } else { %>
  <p class="centro gris">Los compradores no tienen publicaciones.</p>
<% } %>

<%- include('../partials/foot') %>
