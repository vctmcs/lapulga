<%- include('../partials/head') %>

<h1 class="centro">Entrar</h1>

<% if (error) { %><div class="msg msg-error forma"><%= error %></div><% } %>

<form action="/login" method="post" novalidate>
  <table class="forma">
    <tr>
      <td><label for="email">correo</label></td>
      <td><input class="ancho" id="email" name="email" type="email" autocomplete="email" value="<%= valores.email || '' %>"></td>
    </tr>
    <tr>
      <td><label for="password">contraseña</label></td>
      <td>
        <input class="ancho" id="password" name="password" type="password" autocomplete="current-password">
        <label class="chico gris"><input type="checkbox" data-ver-pass="password"> mostrar</label>
      </td>
    </tr>
    <tr>
      <td></td>
      <td><button type="submit" class="amarillo">entrar</button> &nbsp; <small>¿No tienes cuenta? <a href="/registro">regístrate</a></small></td>
    </tr>
  </table>
</form>

<%- include('../partials/foot') %>
