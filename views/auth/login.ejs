<%- include('../partials/head') %>

<div class="auth">
  <div class="auth__lado">
    <h2>Qué gusto verte de nuevo.</h2>
    <ul>
      <li>Ve el teléfono y WhatsApp de los vendedores.</li>
      <li>Publica lo que ya no usas en minutos.</li>
      <li>Regala lo que le sirva a alguien más.</li>
    </ul>
    <p class="mono" style="margin:0;font-size:.85rem">la pulga · usados y donaciones</p>
  </div>

  <form class="auth__form" action="/login" method="post" novalidate>
    <div>
      <h1>Iniciar sesión</h1>
      <p class="suave" style="margin:0">Entra con tu correo y contraseña.</p>
    </div>

    <% if (error) { %><div class="aviso aviso--error" role="alert"><%= error %></div><% } %>

    <div class="campo">
      <label for="email">Correo</label>
      <input class="entrada" id="email" name="email" type="email" autocomplete="email" required value="<%= valores.email || '' %>">
    </div>
    <div class="campo">
      <label for="password">Contraseña</label>
      <div class="ver-pass">
        <input class="entrada" id="password" name="password" type="password" autocomplete="current-password" required>
        <button type="button" data-ver-pass aria-label="Mostrar contraseña"><%- include('../partials/icono', { n: 'ojo' }) %></button>
      </div>
    </div>

    <button class="btn btn--primario btn--bloque" type="submit">Entrar</button>
    <p class="auth__pie">¿No tienes cuenta? <a href="/registro">Regístrate gratis</a></p>
  </form>
</div>

<%- include('../partials/foot') %>
