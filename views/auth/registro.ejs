<%- include('../partials/head') %>
<% const v = valores || {}; %>

<h1 class="centro">Crear cuenta</h1>
<p class="centro gris">Sin comisiones. Tu número solo lo ven usuarios registrados.</p>

<form action="/registro" method="post" novalidate data-registro>
  <table class="forma">
    <tr>
      <td>tipo de cuenta</td>
      <td>
        <label><input type="radio" name="rol" value="comprador" <%= v.rol !== 'vendedor' ? 'checked' : '' %>> comprador</label>
        <span class="ayuda">Busco cosas y quiero ver los contactos.</span>
        <label><input type="radio" name="rol" value="vendedor" <%= v.rol === 'vendedor' ? 'checked' : '' %>> vendedor</label>
        <span class="ayuda">Quiero vender o donar mis artículos. Después un comprador puede pasar a vendedor.</span>
      </td>
    </tr>
    <tr>
      <td><label for="nombre">nombre</label></td>
      <td>
        <input class="ancho" id="nombre" name="nombre" autocomplete="name" maxlength="100" value="<%= v.nombre || '' %>" aria-invalid="<%= !!errores.nombre %>">
        <% if (errores.nombre) { %><span class="error"><%= errores.nombre %></span><% } %>
      </td>
    </tr>
    <tr>
      <td><label for="email">correo</label></td>
      <td>
        <input class="ancho" id="email" name="email" type="email" autocomplete="email" value="<%= v.email || '' %>" aria-invalid="<%= !!errores.email %>">
        <% if (errores.email) { %><span class="error"><%= errores.email %></span><% } %>
      </td>
    </tr>
    <tr>
      <td><label for="telefono">teléfono</label></td>
      <td>
        <input id="telefono" name="telefono" type="tel" autocomplete="tel" placeholder="55 1234 5678" value="<%= v.telefono || '' %>" aria-invalid="<%= !!errores.telefono %>">
        <span class="ayuda" data-opcional>opcional</span>
        <% if (errores.telefono) { %><span class="error"><%= errores.telefono %></span><% } %>
      </td>
    </tr>
    <tr>
      <td><label for="whatsapp">whatsapp</label></td>
      <td>
        <input id="whatsapp" name="whatsapp" type="tel" placeholder="55 1234 5678" value="<%= v.whatsapp || '' %>" aria-invalid="<%= !!errores.whatsapp %>" data-whatsapp>
        <label class="chico"><input type="checkbox" name="mismo_whatsapp" value="1" <%= v.mismo_whatsapp ? 'checked' : '' %> data-mismo-whatsapp> es el mismo número</label>
        <% if (errores.whatsapp) { %><span class="error"><%= errores.whatsapp %></span><% } %>
      </td>
    </tr>
    <tr>
      <td><label for="password">contraseña</label></td>
      <td>
        <input class="ancho" id="password" name="password" type="password" autocomplete="new-password" aria-invalid="<%= !!errores.password %>">
        <% if (errores.password) { %><span class="error"><%= errores.password %></span><% } else { %><span class="ayuda">8 o más caracteres, con letras y números.</span><% } %>
      </td>
    </tr>
    <tr>
      <td><label for="confirmar">confirmar</label></td>
      <td>
        <input class="ancho" id="confirmar" name="confirmar" type="password" autocomplete="new-password" aria-invalid="<%= !!errores.confirmar %>">
        <% if (errores.confirmar) { %><span class="error"><%= errores.confirmar %></span><% } %>
      </td>
    </tr>
    <tr>
      <td></td>
      <td><button type="submit" class="amarillo">crear cuenta</button> &nbsp; <small>¿Ya tienes cuenta? <a href="/login">entra</a></small></td>
    </tr>
  </table>
</form>

<%- include('../partials/foot') %>
