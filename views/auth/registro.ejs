<%- include('../partials/head') %>
<% const v = valores || {}; %>

<div class="auth">
  <div class="auth__lado">
    <h2>Únete a la pulga del barrio.</h2>
    <ul>
      <li>Sin comisiones: el trato es directo entre ustedes.</li>
      <li>Tu número solo lo ven usuarios registrados.</li>
      <li>Cada publicación se revisa para mantener el lugar seguro.</li>
      <li>¿Lo vas a regalar? Ponle precio 0 y aparece como donación.</li>
    </ul>
    <p class="mono" style="margin:0;font-size:.85rem">la pulga · usados y donaciones</p>
  </div>

  <form class="auth__form" action="/registro" method="post" novalidate data-registro>
    <div>
      <h1>Crear cuenta</h1>
      <p class="suave" style="margin:0">Elige cómo vas a usar La Pulga. Después puedes pasar de comprador a vendedor.</p>
    </div>

    <fieldset class="roles" style="border:0;padding:0;margin:0">
      <legend class="sr-only">Tipo de cuenta</legend>
      <div class="rol">
        <input type="radio" id="rol-comprador" name="rol" value="comprador" <%= v.rol !== 'vendedor' ? 'checked' : '' %>>
        <label for="rol-comprador"><strong>Comprador</strong><small>Busco cosas y quiero ver los contactos.</small></label>
      </div>
      <div class="rol">
        <input type="radio" id="rol-vendedor" name="rol" value="vendedor" <%= v.rol === 'vendedor' ? 'checked' : '' %>>
        <label for="rol-vendedor"><strong>Vendedor</strong><small>Quiero vender o donar mis artículos.</small></label>
      </div>
    </fieldset>

    <div class="campo">
      <label for="nombre">Nombre</label>
      <input class="entrada" id="nombre" name="nombre" autocomplete="name" required maxlength="100" value="<%= v.nombre || '' %>" aria-invalid="<%= !!errores.nombre %>">
      <% if (errores.nombre) { %><span class="error"><%= errores.nombre %></span><% } %>
    </div>

    <div class="campo">
      <label for="email">Correo</label>
      <input class="entrada" id="email" name="email" type="email" autocomplete="email" required value="<%= v.email || '' %>" aria-invalid="<%= !!errores.email %>">
      <% if (errores.email) { %><span class="error"><%= errores.email %></span><% } %>
    </div>

    <div class="form-grid" style="gap:1rem">
      <div class="campo">
        <label for="telefono">Teléfono <span class="suave" data-opcional style="font-weight:500">(opcional)</span></label>
        <input class="entrada" id="telefono" name="telefono" type="tel" inputmode="tel" autocomplete="tel" placeholder="55 1234 5678" value="<%= v.telefono || '' %>" aria-invalid="<%= !!errores.telefono %>">
        <% if (errores.telefono) { %><span class="error"><%= errores.telefono %></span><% } %>
      </div>
      <div class="campo">
        <label for="whatsapp">WhatsApp</label>
        <input class="entrada" id="whatsapp" name="whatsapp" type="tel" inputmode="tel" placeholder="55 1234 5678" value="<%= v.whatsapp || '' %>" aria-invalid="<%= !!errores.whatsapp %>" data-whatsapp>
        <% if (errores.whatsapp) { %><span class="error"><%= errores.whatsapp %></span><% } %>
      </div>
      <label class="casilla ancho"><input type="checkbox" name="mismo_whatsapp" value="1" <%= v.mismo_whatsapp ? 'checked' : '' %> data-mismo-whatsapp> Mi WhatsApp es el mismo número</label>
    </div>

    <div class="form-grid" style="gap:1rem">
      <div class="campo">
        <label for="password">Contraseña</label>
        <div class="ver-pass">
          <input class="entrada" id="password" name="password" type="password" autocomplete="new-password" required minlength="8" aria-invalid="<%= !!errores.password %>">
          <button type="button" data-ver-pass aria-label="Mostrar contraseña"><%- include('../partials/icono', { n: 'ojo' }) %></button>
        </div>
        <% if (errores.password) { %><span class="error"><%= errores.password %></span><% } else { %><span class="ayuda">8+ caracteres, letras y números.</span><% } %>
      </div>
      <div class="campo">
        <label for="confirmar">Confirmar</label>
        <input class="entrada" id="confirmar" name="confirmar" type="password" autocomplete="new-password" required aria-invalid="<%= !!errores.confirmar %>">
        <% if (errores.confirmar) { %><span class="error"><%= errores.confirmar %></span><% } %>
      </div>
    </div>

    <button class="btn btn--primario btn--bloque" type="submit">Crear mi cuenta</button>
    <p class="auth__pie">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
  </form>
</div>

<%- include('../partials/foot') %>
