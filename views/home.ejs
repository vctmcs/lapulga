<%- include('partials/head') %>
<%
  const url = (cambios) => {
    const p = { q: filtros.q, cat: filtros.categoria, donacion: filtros.donacion, orden: filtros.orden !== 'recientes' ? filtros.orden : '', ...cambios };
    if (!('pagina' in cambios)) delete p.pagina;
    const qs = Object.entries(p).filter(([, v]) => v !== '' && v !== undefined && v !== null).map(([k, v]) => `${k}=${encodeURIComponent(v)}`).join('&');
    return '/' + (qs ? '?' + qs : '');
  };
  const catActual = categorias.find(c => c.slug === filtros.categoria);
%>

<% if (!hayFiltros && filtros.pagina === 1) { %>
  <p class="centro">
    Lo que a ti te sobra, a alguien le hace falta. Vende lo que ya no usas o regálalo.<br>
    <span class="gris">Sin comisiones y sin chat: el trato es directo por teléfono o WhatsApp. Precio 0 = donación.</span>
  </p>
<% } %>

<div class="filtros">
  <span class="gris">categorías:</span>
  <a href="<%= url({ cat: '' }) %>" class="<%= !filtros.categoria ? 'actual' : '' %>">todas</a>
  <% categorias.forEach(c => { %>
    &middot; <a href="<%= url({ cat: c.slug }) %>" class="<%= filtros.categoria === c.slug ? 'actual' : '' %>"><%= c.nombre.toLowerCase() %></a> <small class="gris">(<%= c.total %>)</small>
  <% }) %>
  <br>
  <span class="gris">mostrar:</span>
  <a href="<%= url({ donacion: '' }) %>" class="<%= !filtros.donacion ? 'actual' : '' %>">todo</a> &middot;
  <a href="<%= url({ donacion: 'no' }) %>" class="<%= filtros.donacion === 'no' ? 'actual' : '' %>">en venta</a> &middot;
  <a href="<%= url({ donacion: 'si' }) %>" class="<%= filtros.donacion === 'si' ? 'actual' : '' %>">donaciones</a>
  &nbsp; <span class="gris">ordenar:</span>
  <a href="<%= url({ orden: '' }) %>" class="<%= filtros.orden === 'recientes' ? 'actual' : '' %>">recientes</a> &middot;
  <a href="<%= url({ orden: 'precio_asc' }) %>" class="<%= filtros.orden === 'precio_asc' ? 'actual' : '' %>">precio menor</a> &middot;
  <a href="<%= url({ orden: 'precio_desc' }) %>" class="<%= filtros.orden === 'precio_desc' ? 'actual' : '' %>">precio mayor</a>
</div>

<p class="gris chico">
  <%= total %> <%= total === 1 ? 'artículo' : 'artículos' %><% if (filtros.q) { %> para "<%= filtros.q %>"<% } %><% if (catActual) { %> en <%= catActual.nombre.toLowerCase() %><% } %>
  <% if (hayFiltros) { %> &middot; <a href="/">quitar filtros</a><% } %>
</p>

<% if (items.length) { %>
  <div class="lista">
    <% items.forEach(p => { %><%- include('partials/tarjeta', { p }) %><% }) %>
  </div>

  <% if (paginas > 1) { %>
    <div class="paginas">
      <% if (filtros.pagina > 1) { %><a href="<%= url({ pagina: filtros.pagina - 1 }) %>">&laquo; anterior</a><% } %>
      <% for (let i = 1; i <= paginas; i++) { %>
        <% if (i === filtros.pagina) { %><span class="actual">[<%= i %>]</span><% } else { %><a href="<%= url({ pagina: i }) %>"><%= i %></a><% } %>
      <% } %>
      <% if (filtros.pagina < paginas) { %><a href="<%= url({ pagina: filtros.pagina + 1 }) %>">siguiente &raquo;</a><% } %>
    </div>
  <% } %>
<% } else { %>
  <p class="centro gris">
    <% if (hayFiltros) { %>No hay artículos con esos filtros. <a href="/">ver todo</a>
    <% } else { %>Todavía no hay publicaciones.
      <a href="<%= !usuario ? '/registro?rol=vendedor' : (usuario.rol === 'vendedor' ? '/publicaciones/nueva' : '/cuenta') %>">publica la primera</a>.
    <% } %>
  </p>
<% } %>

<%- include('partials/foot') %>
