<div class="item">
  <a class="foto" href="/publicaciones/<%= p.id %>"><img src="<%= p.portada ? '/uploads/' + p.portada : '/img/sin-foto.svg' %>" alt="" loading="lazy"></a>
  <a class="titulo" href="/publicaciones/<%= p.id %>"><%= p.titulo %></a>
  <span class="<%= p.es_donacion ? 'dona' : 'precio' %>"><%= f.precio(p.precio) %></span>
  <% if (p.estado === 'vendida') { %><small class="gris">(vendida)</small><% } %>
  <div class="datos"><%= p.categoria || 'sin categoría' %> &middot; <%= f.hace(p.creado_en) %></div>
</div>
