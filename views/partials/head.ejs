<!DOCTYPE html>
<html lang="es-MX">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo ? `${titulo} - La Pulga` : 'La Pulga' %></title>
  <meta name="description" content="La Pulga: compra, vende y dona artículos usados. Contacto directo por teléfono o WhatsApp.">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
<div class="pagina">

<div class="cabecera">
  <a class="logo" href="/"><b>la pulga</b><span>artículos usados y donaciones</span></a>

  <div class="menu">
    <a href="/">inicio</a> <span class="sep">|</span>
    <a href="/?donacion=si">donaciones</a> <span class="sep">|</span>
    <% if (!usuario) { %>
      <a href="/login">entrar</a> <span class="sep">|</span>
      <a href="/registro">registrarse</a> <span class="sep">|</span>
      <a href="/registro?rol=vendedor">vender</a>
    <% } else { %>
      <% if (usuario.rol === 'vendedor') { %>
        <a href="/publicaciones/nueva">publicar</a> <span class="sep">|</span>
        <a href="/mis-publicaciones">mis publicaciones</a> <span class="sep">|</span>
      <% } %>
      <% if (usuario.rol === 'admin') { %>
        <a href="/admin">moderación</a><% if (typeof pendientes !== 'undefined' && pendientes) { %> <a class="contador" href="/admin" title="casos pendientes"><%= pendientes %></a><% } %> <span class="sep">|</span>
      <% } %>
      <a href="/cuenta">mi cuenta</a> <span class="sep">|</span>
      <form class="enlinea" action="/logout" method="post"><button class="enlace" type="submit" style="font-size:12px">salir</button></form>
      <br><small class="gris">sesión: <%= usuario.nombre %> (<%= usuario.rol %>)</small>
    <% } %>
  </div>

  <form class="buscar" action="/" method="get" role="search">
    <label class="sr-only" for="buscar">Buscar</label>
    <input id="buscar" type="search" name="q" maxlength="80" placeholder="buscar..." value="<%= typeof query !== 'undefined' && query.q ? query.q : '' %>">
    <button type="submit">buscar</button>
  </form>
</div>

<hr>

<% if (usuario && usuario.rol === 'vendedor' && !usuario.puede_publicar) { %>
  <div class="msg msg-alerta">Una de tus publicaciones fue reportada y está oculta en revisión. No puedes publicar hasta que el administrador la revise.</div>
<% } %>
<% (flash || []).forEach(m => { %>
  <div class="msg msg-<%= m.tipo %>" role="status"><button type="button" data-cerrar aria-label="cerrar">x</button><%= m.mensaje %></div>
<% }) %>

<main id="contenido">
