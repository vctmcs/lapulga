<!DOCTYPE html>
<html lang="es-MX">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo ? `${titulo} · La Pulga` : 'La Pulga' %></title>
  <meta name="description" content="La Pulga: compra, vende y dona artículos usados cerca de ti. Contacto directo por teléfono o WhatsApp.">
  <meta name="theme-color" content="#f4efe4">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=IBM+Plex+Mono:wght@500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
<a class="sr-only" href="#contenido">Saltar al contenido</a>
<header class="cabecera">
  <div class="contenedor cabecera__fila">
    <%- include('logo') %>

    <form class="buscador" action="/" method="get" role="search">
      <label class="sr-only" for="buscar">Buscar artículos</label>
      <input id="buscar" type="search" name="q" placeholder="Busca bicis, libros, muebles…" value="<%= typeof query !== 'undefined' && query.q ? query.q : '' %>" maxlength="80">
      <button type="submit" aria-label="Buscar"><%- include('icono', { n: 'buscar' }) %></button>
    </form>

    <nav class="nav" aria-label="Principal">
      <a class="nav__link nav__link--texto" href="/?donacion=si" <%= ruta === '/' && query.donacion === 'si' ? 'aria-current=page' : '' %>>Donaciones</a>

      <% if (!usuario) { %>
        <a class="nav__link" href="/login" <%= ruta === '/login' ? 'aria-current=page' : '' %>>Entrar</a>
        <a class="btn btn--primario btn--chico" href="/registro?rol=vendedor"><%- include('icono', { n: 'mas', t: 16 }) %> Vender</a>
      <% } else { %>
        <% if (usuario.rol === 'vendedor') { %>
          <a class="btn btn--primario btn--chico" href="/publicaciones/nueva"><%- include('icono', { n: 'mas', t: 16 }) %> Publicar</a>
        <% } %>
        <% if (usuario.rol === 'admin') { %>
          <a class="btn btn--negro btn--chico" href="/admin"><%- include('icono', { n: 'escudo', t: 16 }) %> Moderación</a>
        <% } %>
        <details class="menu">
          <summary>
            <span class="avatar"><%= f.iniciales(usuario.nombre) %></span>
            <span class="menu__nombre"><%= usuario.nombre.split(' ')[0] %></span>
          </summary>
          <div class="menu__panel">
            <div class="menu__cab"><strong><%= usuario.nombre %></strong><%= usuario.email %></div>
            <hr>
            <% if (usuario.rol === 'vendedor') { %>
              <a href="/mis-publicaciones">Mis publicaciones</a>
              <a href="/usuarios/<%= usuario.id %>">Ver mi perfil público</a>
            <% } %>
            <% if (usuario.rol === 'admin') { %>
              <a href="/admin">Panel de moderación</a>
            <% } %>
            <a href="/cuenta">Mi cuenta</a>
            <hr>
            <form action="/logout" method="post"><button type="submit">Cerrar sesión</button></form>
          </div>
        </details>
      <% } %>
    </nav>
  </div>
</header>

<main id="contenido">
  <div class="contenedor">
    <% if (flash && flash.length) { %>
      <div class="avisos" role="status">
        <% flash.forEach(m => { %>
          <div class="aviso aviso--<%= m.tipo %>"><span><%= m.mensaje %></span><button type="button" aria-label="Cerrar aviso" data-cerrar>&times;</button></div>
        <% }) %>
      </div>
    <% } %>
