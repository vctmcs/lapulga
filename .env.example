# Servidor
PORT=3000
SESSION_SECRET=cambia-esta-cadena-por-una-larga-y-aleatoria

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=tu_password
PGDATABASE=lapulga

# Administrador inicial (lo crea npm run db:setup)
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@lapulga.local
ADMIN_PASSWORD=Admin123!

# Moderación con IA (1 = activo, 0 = apagado). Los términos prohibidos siempre están activos.
IA_TEXTO=1
IA_IMAGEN=1
MODELO_ZERO_SHOT=Xenova/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
# Umbrales: entre más alto, menos publicaciones se marcan
UMBRAL_TEXTO=0.85
UMBRAL_NSFW=0.7
UMBRAL_SEXY=0.9
